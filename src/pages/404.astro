---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Prompt Press">
  <div class="wrap">
    <header class="masthead">
      <div class="masthead-top">
        <span><a href="/">← Prompt Press</a></span>
        <span>404</span>
      </div>
    </header>
    <main class="detail" style="padding-top:48px; text-align:center">
      <h1>That page isn't in the press.</h1>
      <p class="summary">The prompt or page you're looking for doesn't exist — or it moved.</p>
      <a class="btn" href="/">Back to the library →</a>
    </main>
    <footer>
      <span>Prompt Press</span>
      <span><a href="/">Back to library</a></span>
    </footer>
  </div>
</Base>
